{
  "cSpell.words": ["ctxcli", "Mohanty", "oneline", "scanability"],
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "file": ".agents/commit-message.md"
    }
  ],
  "mermaidChart.showGenerateDiagramCodeLens": false,
  "editor.codeLens": true,
  "js/ts.referencesCodeLens.enabled": true,
  "js/ts.implementationsCodeLens.enabled": true,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  }
}
